PORT=3000

# Deployment platforms such as Render can provide one full PostgreSQL URL.
# When present, it takes priority over the individual DB_* variables below.
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=aristo_store_db

JWT_SECRET=super_secret_jwt_key_for_development_change_in_production
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3001

# Shipping
SHIPPING_FEE=10

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
